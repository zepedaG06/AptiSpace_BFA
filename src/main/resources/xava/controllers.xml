<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE controllers SYSTEM "dtds/controllers.dtd">
<controllers>
    <controller name="EvaluadoSeguro">
        <extends controller="Typical" excluded-actions="CRUD.new, CRUD.delete, CRUD.deleteSelected, CRUD.deleteRow, Print.generatePdf, Print.generateExcel, ImportData.importData"/>
    </controller>

    <controller name="AplicacionPrueba">
        <extends controller="Typical"/>
        <action name="iniciar" mode="detail" class="com.aptispace.acciones.IniciarPruebaAction" icon="play_arrow"/>
        <action name="finalizar" mode="detail" class="com.aptispace.acciones.FinalizarPruebaAction" icon="stop"/>
        <action name="calcularResultado" mode="detail" class="com.aptispace.acciones.CalcularResultadoAction" icon="calculate"/>
    </controller>
</controllers>
