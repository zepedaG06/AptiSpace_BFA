<?xml version = "1.0" encoding = "ISO-8859-1"?>

<!DOCTYPE application SYSTEM "dtds/application.dtd">

<application name="AptiSpace_BFA"> 
	
	<!-- 
	A default module for each entity is assumed with the
	controllers on <default-module/>
	-->
	<default-module>		  
		<controller name="Typical"/>		
	</default-module>
	
	<!-- 
	You can define additional modules, for example:	  
	<module name="OnlyReadTeacher">
		<model name="Teacher"/>
		<controller name="Print"/>
	</module>		
	-->

	<module name="CursosPorDocente">
		<model name="Seccion"/>
		<tab name="CursosPorDocente"/>
		<controller name="Typical"/>
	</module>

	<module name="EstudiantesPorSeccion">
		<model name="Matricula"/>
		<tab name="EstudiantesPorSeccion"/>
		<controller name="Typical"/>
	</module>
	
</application>
